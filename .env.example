# Modo online do VTT RPG. Copie este arquivo para .env.local e preencha os valores.
# Sem estas variáveis, o app roda em modo local (offline, no navegador).
# Guia completo: docs/online-setup.md
#
# Nunca prefixe chaves secretas com VITE_. Tudo que começa com VITE_ vai para o navegador.

# Públicas (vão para o navegador)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor (nunca vão para o navegador). SUPABASE_URL tem o mesmo valor de VITE_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SETUP_TOKEN=
